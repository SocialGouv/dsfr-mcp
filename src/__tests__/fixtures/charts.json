{
  "version": "v2.1.1",
  "package": "@gouvfr/dsfr-chart",
  "repository": "https://github.com/GouvernementFR/dsfr-chart",
  "charts": [
    {
      "name": "bar-chart",
      "tag": "<bar-chart>",
      "component": "BarChart",
      "title": "Graphique en barre (BarChart)",
      "description": "Les graphiques en barre sont accessibles à travers la balise : `<bar-chart>`.",
      "aliases": [
        "BarChart",
        "barchart"
      ],
      "documented": true,
      "params": [
        {
          "name": "x",
          "prop": "x",
          "type": "String",
          "required": true,
          "description": "Les valeurs sur l'axe des abscisses sous forme d'une liste de listes entre crochets.",
          "documented": true
        },
        {
          "name": "y",
          "prop": "y",
          "type": "String",
          "required": true,
          "description": "Les valeurs sur l'axe des ordonnées sous forme d'une liste de listes entre crochets.",
          "documented": true
        },
        {
          "name": "horizontal",
          "prop": "horizontal",
          "type": "Boolean | String",
          "required": false,
          "default": "false",
          "description": "Affiche le graphique en barres horizontales.",
          "documented": true
        },
        {
          "name": "selected-palette",
          "prop": "selectedPalette",
          "type": "String",
          "required": false,
          "default": "''",
          "description": "Palette de couleurs utilisée pour le graphique.",
          "allowedValues": [
            "default",
            "neutral",
            "categorical"
          ],
          "documented": true
        },
        {
          "name": "sub-x",
          "prop": "subX",
          "type": "String",
          "required": false,
          "default": "null",
          "description": "",
          "documented": false
        }
      ],
      "examples": [
        {
          "label": "Barres verticales simples",
          "code": "<bar-chart\n  x='[[\"2025\", \"2030\"]]'\n  y=\"[[69.1, 70.3]]\"\n></bar-chart>"
        },
        {
          "label": "Barres horizontales",
          "code": "<bar-chart\n  x='[[\"2025\", \"2030\"]]'\n  y=\"[[10, 20]]\"\n  horizontal=\"true\"\n></bar-chart>"
        }
      ],
      "notes": [
        "Format des données : x et y sont des chaînes représentant des listes."
      ]
    },
    {
